{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AI Dashboard Specification",
  "description": "Complete dashboard spec generated by AI, consumed by frontend renderer",
  "type": "object",
  "required": ["dashboard_id", "created_at", "domain", "dataset_meta", "tabs"],
  "properties": {
    "dashboard_id":  { "type": "string", "format": "uuid" },
    "created_at":    { "type": "string", "format": "date-time" },
    "domain":        { "type": "string" },
    "business_goal": { "type": "string" },
    "theme":         { "type": "string", "enum": ["executive","modern","minimal","dark"], "default": "modern" },
    "dataset_meta": {
      "type": "object",
      "required": ["dimensions", "measures", "time_fields"],
      "properties": {
        "dimensions":                { "type": "array", "items": { "type": "string" } },
        "measures":                  { "type": "array", "items": { "type": "string" } },
        "time_fields":               { "type": "array", "items": { "type": "string" } },
        "row_count":                 { "type": "integer" },
        "analytical_richness_score": { "type": "integer", "minimum": 0, "maximum": 100 },
        "warnings":                  { "type": "array", "items": { "type": "string" } }
      }
    },
    "global_filters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["filter_id", "field", "type"],
        "properties": {
          "filter_id": { "type": "string" },
          "label":     { "type": "string" },
          "field":     { "type": "string" },
          "type":      { "type": "string", "enum": ["date_range","select","multi_select","number_range"] }
        }
      }
    },
    "kpis": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kpi_id", "title", "field", "aggregation"],
        "properties": {
          "kpi_id":          { "type": "string" },
          "title":           { "type": "string" },
          "field":           { "type": "string" },
          "aggregation":     { "type": "string", "enum": ["sum","avg","count","count_distinct","min","max","median"] },
          "format":          { "type": "string", "enum": ["number","currency","percentage","duration"] },
          "prefix":          { "type": "string" },
          "suffix":          { "type": "string" },
          "business_meaning":{ "type": "string" },
          "target_audiences":{ "type": "array", "items": { "type": "string", "enum": ["end_users","middle_management","top_management","c_suite"] } }
        }
      }
    },
    "charts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["chart_id", "title", "type", "fields"],
        "properties": {
          "chart_id":         { "type": "string" },
          "title":            { "type": "string" },
          "type":             { "type": "string", "enum": ["line","area","bar","bar_horizontal","stacked_bar","scatter","pie","donut","heatmap","treemap","funnel","gauge","histogram","box_plot","table"] },
          "fields":           { "type": "object", "properties": { "x": {"type":"string"}, "y": {"type":"string"}, "y2": {"type":"string"}, "series": {"type":"string"}, "value": {"type":"string"}, "label": {"type":"string"} } },
          "aggregation":      { "type": "string", "enum": ["sum","avg","count","count_distinct","min","max"] },
          "top_n":            { "type": "integer" },
          "insight_text":     { "type": "string" },
          "priority_score":   { "type": "integer", "minimum": 1, "maximum": 10 },
          "mobile_friendly":  { "type": "boolean" },
          "recommended_size": { "type": "string", "enum": ["small","medium","large","full"] },
          "target_audiences": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "insights": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["insight_id", "title", "business_meaning"],
        "properties": {
          "insight_id":            { "type": "string" },
          "title":                 { "type": "string" },
          "business_meaning":      { "type": "string" },
          "required_fields":       { "type": "array", "items": { "type": "string" } },
          "calculation_logic":     { "type": "string" },
          "confidence_score":      { "type": "number", "minimum": 0, "maximum": 1 },
          "target_audience":       { "type": "string" },
          "business_impact_score": { "type": "integer", "minimum": 1, "maximum": 10 }
        }
      }
    },
    "tabs": {
      "type": "object",
      "required": ["end_users","middle_management","top_management","c_suite"],
      "properties": {
        "end_users":         { "$ref": "#/definitions/tab" },
        "middle_management": { "$ref": "#/definitions/tab" },
        "top_management":    { "$ref": "#/definitions/tab" },
        "c_suite":           { "$ref": "#/definitions/tab" }
      }
    },
    "validation": {
      "type": "object",
      "properties": {
        "quality_score":          { "type": "integer", "minimum": 0, "maximum": 100 },
        "duplicates_removed":     { "type": "integer" },
        "hallucinations_detected":{ "type": "integer" },
        "invalid_charts_removed": { "type": "integer" },
        "warnings":               { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "definitions": {
    "tab": {
      "type": "object",
      "required": ["label", "kpi_ids", "chart_ids", "layout"],
      "properties": {
        "label":       { "type": "string" },
        "description": { "type": "string" },
        "kpi_ids":     { "type": "array", "items": { "type": "string" }, "maxItems": 6 },
        "chart_ids":   { "type": "array", "items": { "type": "string" } },
        "layout": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id":       { "type": "string" },
              "type":     { "type": "string", "enum": ["kpi","chart"] },
              "col_span": { "type": "integer", "minimum": 1, "maximum": 12 },
              "row_span": { "type": "integer", "minimum": 1, "maximum": 4 },
              "order":    { "type": "integer" }
            }
          }
        }
      }
    }
  }
}
