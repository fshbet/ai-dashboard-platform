# ─── Backend ────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# SQLite database file path
DATABASE_PATH=./data/dashboards.db

# Upload directory
UPLOAD_DIR=./uploads

# ─── n8n ────────────────────────────────────────────────────────
# The full webhook URL from your n8n workflow trigger node
N8N_WEBHOOK_URL=http://localhost:5678/webhook/dashboard-gen

# ─── AI / OpenRouter ────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Primary model
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Fallback model (cheaper)
OPENROUTER_FALLBACK_MODEL=openai/gpt-4o-mini

# ─── Frontend (Next.js) ─────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_APP_NAME=AI Dashboard Platform
